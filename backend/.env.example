# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Database Connection (Supabase PostgreSQL with pgvector)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/knowledge_ai
# Synchronous DB URL for Alembic migrations:
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/knowledge_ai

# Authentication & Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-min-32-chars
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHM=HS256

# Set to true for running tests or local development without live Supabase
DEV_MODE_AUTH=false

# Google Gemini API Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GENERATION_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# Document Processing & Ingestion
# Tokens estimated (~4 chars per token)
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_UPLOAD_SIZE_BYTES=20971520 # 20 MB

# RAG & Retrieval Tuning
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.30
MAX_CONTEXT_TOKENS=4000
ENABLE_QUERY_REFINEMENT=true

# Security & CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_PER_MINUTE=60
